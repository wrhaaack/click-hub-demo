# Copia este archivo como .env para desarrollo local (NO subir el .env real a GitHub).
# En Railway estas mismas variables van en Settings > Variables del servicio.

# Railway la completa sola cuando conectas el servicio de Postgres al proyecto.
# Si usás "npm run db:local", es exactamente esta:
DATABASE_URL=postgres://clickhub:clickhub@127.0.0.1:5433/clickhub

# Genera un valor largo y aleatorio, por ejemplo con: openssl rand -hex 32
SESSION_SECRET=cambiar-por-un-valor-largo-y-aleatorio

# "production" en Railway. En tu compu local dejalo en "development".
NODE_ENV=development

PORT=3000

# Solo hace falta si vas a usar la agenda compartida del estudio.
# Si quedan vacías, el hub anda igual: la seccion de eventos avisa que falta configurar.
# Tiene que coincidir EXACTO con el "URI de redireccionamiento autorizado" que
# En Railway seria: https://TU-DOMINIO/api/google/callback

# Zona horaria con la que se guardan las horas de los eventos.
TZ_ESTUDIO=America/Argentina/Buenos_Aires
